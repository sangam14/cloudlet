# Copy to /etc/cloudlet/vmm.env, set ownership to root:cloudlet and mode 0640.
# Generate this value with: openssl rand -hex 32
CLOUDLET_VMM_AUTH_TOKEN=replace-with-a-64-character-random-token

# Keep the VMM local. Remote operation requires CLOUDLET_VMM_ALLOW_REMOTE=true
# and mTLS/proxy protection in front of the broker.
CLOUDLET_VMM_GRPC_ADDR=[::1]:50051

# Guest Internet egress is disabled by default. llmman remains reachable on
# the private guest bridge without this option.
# CLOUDLET_ALLOW_GUEST_EGRESS=true
