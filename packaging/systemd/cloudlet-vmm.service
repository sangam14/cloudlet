[Unit]
# Legacy only: build cloudlet with --features legacy-vmm before using this unit.
# The BoxLite dashboard does not use this broker or need CAP_NET_ADMIN.
Description=Cloudlet legacy privileged VMM broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudlet
Group=cloudlet
SupplementaryGroups=kvm
WorkingDirectory=/opt/cloudlet
EnvironmentFile=/etc/cloudlet/vmm.env
ExecStart=/opt/cloudlet/target/release/cloudlet vmm-service
Restart=on-failure
RestartSec=2

# Give only the broker the capability required to create TAP/bridge devices.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true

# KVM and TAP are the only device interfaces the VMM needs.
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw

UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
