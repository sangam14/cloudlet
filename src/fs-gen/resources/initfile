#! /bin/sh
#
# /init executable file in the initramfs
#
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

ip link set up dev lo

export CARGO_HOME='/usr/local/cargo'
export RUSTUP_HOME='/usr/local/rustup'
export RUST_VERSION='1.77.2'

export PATH=$CARGO_HOME/bin:$PATH

ln -s /proc/net/pnp /etc/resolv.conf

# The VMM supplies a fresh, hex-encoded token on the kernel command line for
# every guest boot. It authenticates the host-to-agent RPC path without adding
# the token to the workload process environment.
for cloudlet_arg in $(cat /proc/cmdline); do
    case "$cloudlet_arg" in
        cloudlet.agent-token=*)
            export CLOUDLET_AGENT_AUTH_TOKEN="${cloudlet_arg#cloudlet.agent-token=}"
            ;;
    esac
done

exec /agent

reboot
